# Required.
# Local: postgresql://postgres:postgres@localhost:5432/practitioner_passport
#
# Supabase: Dashboard → Settings → Database
# • IPv4-only network: use Shared pooler — Session mode typically port 5432; Transaction pooler often 6543.
# • Direct db.*.supabase.co:5432 is often IPv6-only (ENETUNREACH); prefer pooler hostname from the dashboard.
# Copy “Session pooler” or “Transaction pooler” URI verbatim; URL-encode @ in password as %40.
# Examples:
#   postgresql://postgres.<REF>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
#   postgresql://postgres.<REF>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Set to 0 to disable resolving the DB hostname to IPv4 (fixes ENETUNREACH on IPv6-only paths).
# DATABASE_FORCE_IPV4=0

# If ENETUNREACH persists: IPv4 literal for DATABASE_URL hostname (TLS SNI still uses hostname from URL).
# Example: DATABASE_HOST_IPV4=203.0.113.42   # from: dig +short A your-db-host.example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aksaminyeasir@gmail.com
SMTP_PASS=omysipddjqzrhxqn
MAIL_FROM=Practitioner Passport <your_email@gmail.com>
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5174
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

